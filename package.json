{
  "name": "ai-qa-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-authored, plain-Playwright-run QA pipeline. AI is spent only when something is created or has broken — never on the happy path.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "gen:index": "tsx scripts/generate-index.ts",
    "gen:report": "tsx scripts/generate-report.ts",
    "gen:report:editorial": "tsx scripts/generate-report.ts --theme=editorial",
    "gen:report:dark": "tsx scripts/generate-report.ts --theme=dark",
    "gen:dashboard": "tsx scripts/generate-dashboard.ts",
    "gen:dashboard:editorial": "tsx scripts/generate-dashboard.ts --theme=editorial",
    "gen:dashboard:dark": "tsx scripts/generate-dashboard.ts --theme=dark",
    "sync:skills": "tsx scripts/sync-skills.ts",
    "postinstall": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "gray-matter": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
